#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 🔒 Archivos sensibles
firebase_options.dart
google-services.json
GoogleService-Info.plist

# Variables de entorno
.env
.env.*

# Logs y cachés extra
**/.kotlin/
**/android/.gradle/
firebase-debug.log
firestore-debug.log
ui-debug.log
*.apk
*.aab
*.ipa
coverage/
Thumbs.db
desktop.ini

# Android signing y rutas locales (también en android/.gitignore)
key.properties
**/*.keystore
**/*.jks
**/local.properties
*.hprof

# Configuración local de Flutter/Dart
pubspec_overrides.yaml
devtools_options.yaml

# Claves de servicio Firebase (nunca en el repo)
*-firebase-adminsdk-*.json
serviceAccount*.json

# Evitar artefactos Flutter duplicados en la raíz del monorepo
/pubspec.lock
/.metadata
/analysis_options.yaml
/assets/
/firebase.json

# Tests de reglas de Firestore
/firestore-tests/node_modules/
/scripts/node_modules/
/scripts/*.json
!/scripts/package.json
!/scripts/package-lock.json
*-debug.log
